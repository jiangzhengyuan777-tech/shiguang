# ========================================
# 拾光 · Docker Compose 环境变量示例
# 复制为 .env 后填入自己的配置
#   cp .env.example .env
# ========================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me

# ---------- 前端对外端口 ----------
FRONTEND_PORT=8090

# ---------- Session 密钥（生产环境请改成随机长字符串）----------
SESSION_SECRET_KEY=change-me-to-a-random-secret

# ---------- AI 大模型（OpenAI 兼容接口）----------
# 默认示例用 DeepSeek；换阿里云百炼 / Kimi / 本地 Ollama 都只需改这三行
#   DeepSeek   https://api.deepseek.com/v1                          deepseek-chat
#   阿里云百炼  https://dashscope.aliyuncs.com/compatible-mode/v1    qwen-plus
#   Kimi       https://api.moonshot.cn/v1                           moonshot-v1-8k
#   本地 Ollama http://127.0.0.1:11434/v1                           qwen2.5
DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_MODEL=deepseek-chat

# ---------- 配图（可选，留空会自动降级为随机图/图标）----------
# Pexels 免费图库：https://www.pexels.com/api/
PEXELS_API_KEY=
# Gemini 生图（VIP 功能）
NANO_BANANA_API_KEY=
# 腾讯云 COS（图片托管，不配则配图为外链）
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=

# ---------- 支付（可选）----------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
